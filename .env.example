# @mastra/telegram — example env (never commit real values; use Infisical)

# BotFather bot token — the credential (one per bot). @chat-adapter/telegram reads this.
TELEGRAM_BOT_TOKEN=YOUR_BOT_TOKEN_HERE

# Per-bot secret echoed back as X-Telegram-Bot-Api-Secret-Token on every webhook POST (verified).
TELEGRAM_WEBHOOK_SECRET_TOKEN=YOUR_RANDOM_SECRET_HERE

# Bot @username (or resolved via getMe).
TELEGRAM_BOT_USERNAME=your_bot

# Public HTTPS base URL used for setWebhook (or auto-detected from the Mastra server).
MASTRA_SERVER_BASE_URL=https://your-app.example.com

# Storage for ChannelsStorage (installations). Postgres or libSQL.
DATABASE_URL=postgres://...
